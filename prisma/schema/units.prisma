model Unit {
  id Int @id @default(autoincrement())
  mulId Int @unique
  name String
  group String?
  class String
  variant String?
  technology String?
  rules String?
  date_introduced Int?
  role String?
  type String
  subtype String?
  size Int
  move String
  tmm Int
  armor Int
  structure Int
  threshold Int
  damage_s Int
  damage_s_min Boolean
  damage_m Int
  damage_m_min Boolean
  damage_l Int
  damage_l_min Boolean
  damage_e Int
  damage_e_min Boolean
  overheat Int
  pv Int
  abilities String?
  unitAbilities UnitAbility[]
  unitSpecialPilotAbilities SpecialPilotAbility[]
  tonnage Int? @default(0)
  image_url String?
  availability Availability[]
}

model UnitAbility {
  id Int @id @default(autoincrement())
  unitId Int
  abilityId String
  unit Unit @relation(fields: [unitId], references: [id])
  ability AbilityData @relation(fields: [abilityId], references: [abbreviation])

  value Int?
  valueMin Boolean?
  short Int?
  shortMin Boolean?
  medium Int?
  mediumMin Boolean?
  long Int?
  longMin Boolean?
  extreme Int?
  extremeMin Boolean?
  
  lamData String?
  artilleryType String?

  turretId Int?
  turret UnitAbility? @relation("TurretAbilities", fields: [turretId], references: [id])
  turretAbilities UnitAbility[] @relation("TurretAbilities")
}

model AbilityData {
  name String
  abbreviation String @id
  page String
  weapon Boolean
  ammo Boolean
  numbered Boolean

  UnitAbilities UnitAbility[]
}

model SpecialPilotAbility {
  id Int @id @default(autoincrement())
  name String @unique
  cost Int
  page String

  linkUnits Unit[]
}

model Ammo {
  id Int @id @default(autoincrement())
  name String
  requiredSpecial String
  group String
  page String
}

model CustomCard {
  id Int @id @default(autoincrement())
  pack String
  mulId Int @unique
  name String
  class String
  variant String
  type String
  pv Int
  abilities String
}

model UnitImage {
  id Int @id @default(autoincrement())
  link String
}
